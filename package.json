{
  "name": "portgraph",
  "version": "0.1.1",
  "description": "Local port topology TUI and MCP server for dev stacks, Docker, and local LLM servers",
  "type": "module",
  "license": "MIT",
  "bin": {
    "portgraph": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./bridge": "./dist/bridge.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "jsr.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "publint": "^0.3.12",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "author": "Augusto Cerrutti <augustocerruttisatto@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanchingyg/portgraph.git"
  },
  "mcpName": "io.github.kanchingyg/portgraph",
  "homepage": "https://github.com/kanchingyg/portgraph#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "typescript",
    "rust",
    "ports",
    "networking",
    "tui",
    "docker",
    "ollama",
    "devops"
  ]
}
